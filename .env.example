# DeepSeek API 配置
# 请在此填入你的 DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek 官方 API 基础地址（默认无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 中转代理服务运行的主机与端口
HOST=127.0.0.1
PORT=8000

# 日志输出根目录（默认为当前项目下的 logs 目录）
LOG_DIR=./logs

# 是否保存底层原始 JSON 报文（默认 false 输出纯文本对话；若设为 true 或启动加 --raw 则输出原始大 JSON）
DUMP_RAW_JSON=false

